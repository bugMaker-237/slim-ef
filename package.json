{
  "name": "slim-ef",
  "version": "0.9.0",
  "description": "An implementation of basic entity framework functionnalities in typescript",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start:dev": "nodemon",
    "build": "tsc",
    "build:all": "npm run build && npm run build --workspace=packages/slim-ef-typeorm",
    "format": "prettier --write \"src/**/*.(ts|js)\"",
    "lint": "eslint src --ext .ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run test",
    "preversion": "npm run lint",
    "version": "npm run format && git tag v%npm_package_version%",
    "postversion": "git push && git push --tags",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugMaker-237/slim-ef.git"
  },
  "keywords": [
    "ef-core",
    "linq",
    "orm",
    "expression",
    "entity-framework",
    "mongo",
    "mongodb",
    "mysql",
    "mariadb",
    "postgresql",
    "sqlite",
    "sqlite3",
    "ts",
    "typescript",
    "js",
    "javascript",
    "entity",
    "ddd",
    "slim-ef",
    "unit-of-work",
    "data-mapper",
    "identity-map"
  ],
  "author": "bugmaker-237",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bugMaker-237/slim-ef/issues"
  },
  "homepage": "https://github.com/bugMaker-237/slim-ef#readme",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.57",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "mysql": "^2.18.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.10",
    "sqlite3": "^5.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "ts-jest",
        {
          "tsconfig": "tests/tsconfig.json"
        }
      ]
    },
    "testRegex": "tests.*\\.test\\.(ts)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "moduleNameMapper": {
      "^slim-ef-typeorm$": "<rootDir>/packages/slim-ef-typeorm/src/index.ts",
      "^slim-ef$": "<rootDir>/src/index.ts"
    }
  },
  "dependencies": {
    "slim-exp": "^0.3.2",
    "typeorm": "^0.2.41"
  }
}
