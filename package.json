{
  "name": "@slim-ef",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo root. Published packages live in packages/*. See @slim-ef/core and @slim-ef/typeorm.",
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start:dev": "nodemon",
    "build": "npm run build --workspace=packages/core && npm run build --workspace=packages/typeorm",
    "build:core": "npm run build --workspace=packages/core",
    "build:typeorm": "npm run build --workspace=packages/typeorm",
    "format": "prettier --write \"packages/**/*.(ts|js)\"",
    "prepublishOnly": "npm run lint && npm run test",
    "preversion": "npm run format",
    "version": "git tag v%npm_package_version%",
    "postversion": "git push && git push --tags",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugMaker-237/slim-ef.git"
  },
  "keywords": [
    "ef-core",
    "linq",
    "orm",
    "expression",
    "entity-framework",
    "mongo",
    "mongodb",
    "mysql",
    "mariadb",
    "postgresql",
    "sqlite",
    "sqlite3",
    "ts",
    "typescript",
    "js",
    "javascript",
    "entity",
    "ddd",
    "slim-ef",
    "unit-of-work",
    "data-mapper",
    "identity-map"
  ],
  "author": "bugmaker-237",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bugMaker-237/slim-ef/issues"
  },
  "homepage": "https://github.com/bugMaker-237/slim-ef#readme",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "ts-jest",
        {
          "tsconfig": "tests/tsconfig.json"
        }
      ]
    },
    "testRegex": "tests.*\\.test\\.(ts)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "moduleNameMapper": {
      "^@slim-ef/typeorm$": "<rootDir>/packages/typeorm/src/index.ts",
      "^@slim-ef/core$": "<rootDir>/packages/core/src/index.ts"
    }
  },
  "dependencies": {
    "slim-exp": "^0.4.0",
    "typeorm": "^1.1.0"
  }
}
