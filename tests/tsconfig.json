{
  "compilerOptions": {
    "incremental": true,
    "target": "es2017",
    "module": "commonjs",
    "allowJs": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "lib",
    "rootDir": "../",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "slim-ef": ["../src/index.ts"],
      "slim-ef-typeorm": ["../packages/slim-ef-typeorm/src/index.ts"]
    }
  },
  "include": ["./*"],
  "exclude": ["node_modules"]
}
