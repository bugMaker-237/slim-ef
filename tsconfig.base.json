{
  "compilerOptions": {
    "incremental": true,
    "target": "es2022",
    "module": "esnext",
    "allowJs": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "lib",
    "rootDir": "packages",
    "moduleResolution": "bundler",
    "esModuleInterop": true,

    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "exclude": ["node_modules", "tests", "**/__tests__/*"]
}
